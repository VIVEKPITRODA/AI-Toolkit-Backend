# Server Configuration
NODE_ENV=development
PORT=5001

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/ai-toolkit-hub

# JWT Secret
JWT_SECRET=your_jwt_secret

# Hugging Face API Key
# Steps:
# 1. Go to https://huggingface.co
# 2. Create/Login to your account
# 3. Open Settings → Access Tokens
# 4. Create New Token
# 5. Copy token and paste below
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Groq API Key
# Steps:
# 1. Go to https://console.groq.com
# 2. Login/Create account
# 3. Open API Keys section
# 4. Create API Key
# 5. Copy key and paste below
GROQ_API_KEY=your_groq_api_key

REACT_APP_API_BASE=http://localhost:5001/api

FRONTEND_URL=http://localhost:3000

# Email Configuration
# ─── Email (Brevo SMTP) ───────────────────────────────────
# 1. Sign up free at https://app.brevo.com
# 2. Go to SMTP & API → SMTP tab
# 3. Generate an SMTP key (EMAIL_PASS)
# 4. EMAIL_USER = your Brevo account login email
# 5. Add & verify a sender at Brevo → Senders & Domains

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM=your_email@example.com